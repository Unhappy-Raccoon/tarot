NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Public HTTPS URL where Telegram can open the Mini App.
TELEGRAM_WEBAPP_URL=https://your-webapp.example.com
# Exact origin allowed to call the API from the WebApp.
WEBAPP_ORIGIN=https://your-webapp.example.com
VITE_API_URL=https://your-api.example.com

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# At least 32 random characters. Never expose this value to the browser.
SESSION_SECRET=

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_cosmic_journal

# AI provider — set provider/key/model on the server only.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Daily horoscope fallback timezone when none is supplied by the WebApp.
HOROSCOPE_DEFAULT_TIME_ZONE=Europe/Tallinn

# Provisional, configurable AI chat limits. Exact Free/Premium values require product approval.
AI_FREE_DAILY_LIMIT=5
AI_PREMIUM_DAILY_LIMIT=50
AI_MAX_INPUT_CHARS=1200
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=500
AI_REQUEST_TIMEOUT_MS=25000

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Public HTTPS URL where Telegram can open the Mini App.
TELEGRAM_WEBAPP_URL=https://your-webapp.example.com
# Exact origin allowed to call the API from the WebApp.
WEBAPP_ORIGIN=https://your-webapp.example.com
VITE_API_URL=https://your-api.example.com

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# At least 32 random characters. Never expose this value to the browser.
SESSION_SECRET=

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_cosmic_journal

# AI provider is selected in a later implementation stage.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Copy to .env.test and replace every placeholder before starting the API.
# Keep the PostgreSQL password URL-safe (letters, digits, underscore or hyphen).
POSTGRES_DB=pcj_test
POSTGRES_USER=pcj_test
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD

# Telegram Bot created for the test environment.
TELEGRAM_BOT_TOKEN=
# Generate at least 32 random characters; do not reuse a development secret.
SESSION_SECRET=

# The Mini App URL and allowed origin must use the same HTTPS host.
TELEGRAM_WEBAPP_URL=https://journal.example.com
WEBAPP_ORIGIN=https://journal.example.com

# AI provider is required for the test launch; credentials stay on the API server.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

HOROSCOPE_DEFAULT_TIME_ZONE=Europe/Tallinn
LOG_LEVEL=info

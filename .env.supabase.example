# Copy values into the appropriate deployment secret store. Never commit real values.
# Supabase Dashboard -> Connect -> Transaction pooler; keep SSL enabled.
SUPABASE_PROJECT_REF=your-project-ref
DATABASE_URL=postgresql://postgres.your-project-ref:URL_ENCODED_DB_PASSWORD@YOUR-POOLER-HOST:6543/postgres?sslmode=require
SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# Public WebApp URL. Cloudflare Pages provides a *.pages.dev URL; a custom domain is optional.
TELEGRAM_WEBAPP_URL=https://your-project.pages.dev
WEBAPP_ORIGIN=https://your-project.pages.dev
VITE_API_URL=https://your-project-ref.supabase.co/functions/v1/api

# Server-side secrets. Set with Supabase CLI secrets or in Dashboard, never in the WebApp.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
HOROSCOPE_DEFAULT_TIME_ZONE=Europe/Tallinn
LOG_LEVEL=info

# Edge Functions should keep the pool small; use 1 for a single isolate.
DATABASE_POOL_MAX=1

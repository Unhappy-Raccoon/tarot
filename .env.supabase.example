# Copy to .env.supabase locally, fill values, then:
# npm run secrets:supabase (or run: supabase secrets set --env-file .env.supabase)
# Never commit the real .env.supabase file.

# Supabase project URL and Session Pooler connection string.
# Session mode is required here because postgres.js pipelining + Drizzle transactions
# are not safe with Supabase's shared transaction-mode pooler.
# PROJECT_URL is used only by the local Telegram webhook setup script.
PROJECT_URL=https://your-project-ref.supabase.co
DATABASE_URL=postgresql://postgres.your-project-ref:URL_ENCODED_DB_PASSWORD@YOUR-SESSION-POOLER-HOST:5432/postgres?sslmode=require

# Telegram test bot @my_first_tarot_test_bot and application session.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
SESSION_SECRET=replace-with-at-least-32-random-characters

# Secret used by the Supabase Cron worker; store the same value in Supabase Vault.
HOROSCOPE_CRON_SECRET=replace-with-another-random-webhook-secret

# GitHub Pages HTTPS URL and its origin.
TELEGRAM_WEBAPP_URL=https://unhappy-raccoon.github.io/tarot/
WEBAPP_ORIGIN=https://unhappy-raccoon.github.io

# AI provider credentials and model.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

HOROSCOPE_DEFAULT_TIME_ZONE=Europe/Tallinn
LOG_LEVEL=info
DATABASE_POOL_MAX=1

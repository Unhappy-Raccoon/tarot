# Copy to .env.supabase locally, fill values, then:
# supabase secrets set --env-file .env.supabase
# Never commit the real .env.supabase file.

# Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
# Use the exact hostname and username shown by the Dashboard; URL-encode the DB password.
DATABASE_URL=postgresql://postgres.your-project-ref:URL_ENCODED_DB_PASSWORD@YOUR-POOLER-HOST:6543/postgres?sslmode=require

# Telegram test bot @my_first_tarot_test_bot and application session.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Pages HTTPS URL (the *.pages.dev URL is sufficient for a test).
TELEGRAM_WEBAPP_URL=https://your-project.pages.dev
WEBAPP_ORIGIN=https://your-project.pages.dev

# AI provider credentials and model.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

HOROSCOPE_DEFAULT_TIME_ZONE=Europe/Tallinn
LOG_LEVEL=info
DATABASE_POOL_MAX=1
